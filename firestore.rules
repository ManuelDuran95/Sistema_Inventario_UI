rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if autenticado() && request.auth.uid == userId;
    }

    match /activos/{activoId} {
      allow read: if autenticado();
      allow create: if autenticado()
        && request.resource.data.registradoPorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /requerimientos/{reqId} {
      allow read: if autenticado();
      allow create: if autenticado()
        && request.resource.data.creadoPorUid == request.auth.uid;
      allow update: if autenticado()
        && request.resource.data.finalizadoPorUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['estado', 'finalizadoEn', 'finalizadoPor', 'finalizadoPorUid']);
      allow delete: if false;
    }

    match /contadores/{contadorId} {
      allow read, write: if autenticado();
    }
  }
}
